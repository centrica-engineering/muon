  <muon-inputter validation='["isRequired"]' value={{@selectedOccasion}} {{on 'change' this.updateOccasion}}>
    <label slot="label" for="occasion-select">Select an option</label>
    <select id="occasion-select" name="select">
      <option value="">Select your occasion</option>
      {{#each @occasions as |occasion|}}
          <option value={{occasion}}>{{occasion}}</option>
      {{/each}}
    </select>
  </muon-inputter>

  <muon-inputter {{on 'change' this.updateOccasion}}>
    <label slot="label" for="occasion-other">Or other</label>
    <input id="occasion-other" type="text" placeholder="e.g. Graduation" value={{this.customOccasion}}>
  </muon-inputter>