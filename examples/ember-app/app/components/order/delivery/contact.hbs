<h2>Personal details</h2>

<muon-inputter {{on "change" this.updateTitle}}>
  <label slot="label" for="contact-title">Title</label>
  <input id="contact-title" autocomplete="honorific-prefix" type="text" value={{@contact.title}}>
</muon-inputter>

<muon-inputter validation='["isRequired"]' {{on "change" this.updateFirstname}}>
  <label slot="label" for="contact-firstname">First name</label>
  <input id="contact-firstname" autocomplete="given-name" type="text" value={{@contact.firstname}}>
</muon-inputter>

<muon-inputter validation='["isRequired"]' {{on "change" this.updateLastname}}>
  <label slot="label" for="contact-lastname">Surname</label>
  <input id="contact-lastname" autocomplete="family-name" type="text" value={{@contact.lastname}}>
</muon-inputter>

<muon-inputter validation='["isRequired","isEmail"]' {{on "change" this.updateEmail}}>
  <label slot="label" for="contact-email">Email</label>
  <input id="contact-email" autocomplete="email" type="email" placeholder="e.g. yummy@cake-config.co.uk" value={{@contact.email}}>
</muon-inputter>

<muon-inputter mask="0000-000-0000" separator="-" validation='["isRequired"]' {{on "change" this.updatePhone}}>
  <label slot="label" for="contact-phone">Phone</label>
  <input id="contact-phone" autocomplete="tel" type="tel" value={{@contact.phone}}>
</muon-inputter>